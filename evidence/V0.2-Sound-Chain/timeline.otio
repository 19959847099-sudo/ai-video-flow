                    "speaker": "林夏",
                    "stale": false,
                    "start": 0.3,
                    "text": "这把伞，\n是不是有人来找过？"
                },
                {
                    "dialogue_id": "d872df4de9e459dea9ff3daa97461fb3",
                    "end": 3.0,
                    "speaker": "店员",
                    "stale": false,
                    "start": 2.7,
                    "text": "没有。"
                },
                {
                    "dialogue_id": "058d7d07c84f57008e2219a6f0e4d0b0",
                    "end": 4.6,
                    "speaker": "林夏",
                    "stale": false,
                    "start": 3.35,
                    "text": "我再等等。"
                }
            ]
        }
    },
